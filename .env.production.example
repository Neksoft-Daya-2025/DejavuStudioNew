DEJAVU_API_PORT=3001
DEJAVU_AUTH_MODE=production
DEJAVU_ALLOW_TEST_LOGIN=false
DEJAVU_SESSION_HOURS=8
DEJAVU_DATA_FILE=/var/lib/dejavu-studio/dejavu-db.json
DEJAVU_ALLOWED_ORIGINS=https://studio.example.com

# First administrator account
DEJAVU_ADMIN_EMAIL=admin@example.com
DEJAVU_ADMIN_PASSWORD=replace-with-a-long-random-password

# Frontend. Keep /api/v1 when the API is reverse-proxied on the same domain.
VITE_DEJAVU_API_URL=/api/v1

# SMTP / email notifications
DEJAVU_SMTP_HOST=smtp.gmail.com
DEJAVU_SMTP_PORT=587
DEJAVU_SMTP_USER=admin@example.com
DEJAVU_SMTP_PASS=replace-with-provider-app-password
DEJAVU_FROM_EMAIL=studio@example.com
DEJAVU_FROM_NAME=Déjà Vu Studio
